# ==========================================
# Root .gitignore for TechShare Monorepo
# ==========================================

# Dependencies & Lockfiles
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Environment Variables & Secrets
.env
.env.*
!.env.example

# OS & Editor Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs, Build Artifacts & Temporary Files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.cache/
.next/
**/.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts
scratch_bundle.js

# Local Databases
*.db
*.db-shm
*.db-wal
*.sqlite
