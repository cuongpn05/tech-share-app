# ==========================================
# Server (Node.js Express) .gitignore
# ==========================================

# Dependencies & Lockfiles
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Environment Variables & Secrets
.env
.env.local
.env.*.local
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build & Coverage
dist/
coverage/
.cache/

# OS & Editor Files
.DS_Store
Thumbs.db
.vscode/
.idea/
